[sub_resource type="GDScript" id="GDScript_w5aja"]
script/source = "class_name Board
extends Node3D

@export_category(\"Board Size\")
@export_range(1, 100) var columns: int = 13
@export_range(1, 100) var rows: int = 1
@export var cell_size: float = 1.0

@export_category(\"Scenes\")
@export var cell_scene: PackedScene


func _ready() -> void:
	generate_board()
	pass


func generate_board() -> void:
	if cell_scene == null:
		return

	for x in range(columns):
		for y in range(rows):
			create_cell(x, y)


func create_cell(x: int, y: int) -> void:
	var cell = cell_scene.instantiate()

	add_child(cell)

	var offset_x := (columns - 1) * 0.5
	var offset_y := (rows - 1) * 0.5

	cell.position = Vector3(
		(x - offset_x) * cell_size,
		0.0,
		(y - offset_y) * cell_size
	)
"

